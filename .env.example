# ─────────────────────────────────────────────────────────────────────────────
# MS Nettoyage — variables d'environnement
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# `.env.local` ne doit JAMAIS être commité (déjà couvert par .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# URL canonique du site en production, sans slash final.
# Sert aux balises canonical, à l'Open Graph, au sitemap et au JSON-LD.
NEXT_PUBLIC_SITE_URL="https://ms-nettoyages.com"

# ── Envoi des demandes de devis (SMTP) ───────────────────────────────────────
# Serveur SMTP de la messagerie du domaine, chez Amen : smtp.securemail.pro.
# Le port 465 chiffre dès la connexion ; le 587 ne chiffre qu'après un STARTTLS.
SMTP_HOST="smtp.securemail.pro"
SMTP_PORT="465"

# Identifiants de la boîte d'envoi. Le mot de passe est un secret : il ne vit
# que dans `.env.local` en local et dans les variables du projet Vercel.
SMTP_USER="contact@ms-nettoyages.com"
SMTP_PASSWORD=""

# Expéditeur des emails. DOIT appartenir au domaine authentifié par SPF et DKIM,
# sinon les messages partent en indésirables. L'adresse du visiteur est placée
# en Reply-To, jamais en expéditeur : ce serait une usurpation.
CONTACT_FROM_EMAIL="contact@ms-nettoyages.com"

# Boîtes qui reçoivent les demandes de devis, séparées par des virgules.
# Une seconde adresse sur le domaine sert de filet : si la boîte principale
# refuse le message, la demande reste récupérable. C'est arrivé, Gmail ayant
# rejeté toutes les demandes tant que le domaine n'avait pas de SPF.
CONTACT_TO_EMAIL="msnettoyage211@gmail.com,contact@ms-nettoyages.com"

# ── Vérification de propriété auprès des moteurs (optionnel) ─────────────────
# Codes fournis par Google Search Console et Bing Webmaster Tools, méthode
# « balise HTML ». Laisser vide n'émet aucune balise.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
